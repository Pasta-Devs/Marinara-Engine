{
  "name": "@marinara-engine/server",
  "version": "2.5.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "mari": "./dist/bin/mari.js"
  },
  "scripts": {
    "dev": "tsx watch --ignore ./data --ignore ../shared/dist --ignore ./node_modules --ignore ../../node_modules src/index.ts --marinara-dev-watch",
    "build": "node ./scripts/build.mjs",
    "start": "node ../../scripts/run-server.mjs dist/index.js",
    "clean": "node -e \"const fs=require('fs');['dist','tsconfig.tsbuildinfo'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch{}})\"",
    "lint": "tsc -b ../shared && tsc --noEmit && tsc -p ../../scripts/regressions/tsconfig.character-activity.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.306",
    "@anthropic-ai/sdk": "^0.137.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@emnapi/runtime": "^1.11.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.4",
    "@fastify/static": "^10.1.6",
    "@huggingface/transformers": "^4.3.1",
    "@img/sharp-wasm32": "0.35.5",
    "@marinara-engine/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "adm-zip": "^0.6.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "buttplug": "5.0.2",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "jsonrepair": "^3.15.0",
    "nanoid": "^6.0.2",
    "pdf-parse": "^2.4.5",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "quickjs-emscripten": "0.32.0",
    "undici": "^8.12.3",
    "zod": "^4.6.7",
    "zod-v3": "npm:zod@3.25.76"
  },
  "optionalDependencies": {
    "onnxruntime-node": "1.30.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}

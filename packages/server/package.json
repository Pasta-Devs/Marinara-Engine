{
  "name": "@marinara-engine/server",
  "version": "2.4.6",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "mari": "./dist/bin/mari.js"
  },
  "scripts": {
    "dev": "tsx watch --ignore ./data --ignore ../shared/dist --ignore ./node_modules --ignore ../../node_modules src/index.ts --marinara-dev-watch",
    "build": "node ./scripts/build.mjs",
    "start": "node ../../scripts/run-server.mjs dist/index.js",
    "clean": "node -e \"const fs=require('fs');['dist','tsconfig.tsbuildinfo'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch{}})\"",
    "lint": "tsc -b ../shared && tsc --noEmit && tsc -p ../../scripts/regressions/tsconfig.character-activity.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "@anthropic-ai/sdk": "^0.93.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.4",
    "@huggingface/transformers": "^4.3.0",
    "@marinara-engine/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "adm-zip": "^0.6.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "buttplug": "5.0.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "jsonrepair": "^3.15.0",
    "nanoid": "^5.1.16",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "quickjs-emscripten": "0.32.0",
    "undici": "^7.28.0",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@img/sharp-wasm32": "0.35.4",
    "onnxruntime-node": "1.30.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.13.5",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}

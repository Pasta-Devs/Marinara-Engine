  "gm": {
    "checkGuidance": "This game uses 5e rules from SRD 5.1. Call for an ability check, skill check or saving throw only when the outcome is uncertain and failure is interesting. Name the skill or the save and set a DC from the ladder below. Never add modifiers, never state a total and never decide the result: the Engine applies the character sheet and reports the outcome. A natural 20 or natural 1 has no special effect on checks or saves.",
    "sheetGuidance": "The character sheets below are authoritative. A character can only cast a spell that is on their sheet and only with a slot they still have. When a character spends or regains a resource, takes damage, heals, gains or loses a condition, or rests, record it with the sheet command. If a command is refused, the fiction did not happen: narrate around it.",
    "sheetSummary": {
      "fields": ["level", "class", "ac", "speed"],
      "derived": ["proficiency_bonus", "passive_perception", "spell_save_dc", "spell_attack"],
      "lists": [
        {
          "list": "spells",
          "nameColumn": "name",
          "groupBy": "level",
          "onlyWhen": "prepared"
        },
        {
          "list": "attacks",
          "nameColumn": "name"
        }
      ]
    }
  },
  "battle": {
    "$comment": "What a battle may read from this sheet. It is not a 5e combat adapter: there are no attack rolls, no saving throws and no concentration in a fight, and the damage arithmetic stays Marinara's. Hit points, slots and the spells and attacks a player picked from a catalog are simply lent to Marinara's own combat. Pact Magic slots are left out, because their level follows the character's own level and a fixed list of levels cannot say that.",
    "health": { "pool": "hp" },
    "slots": [
      { "pool": "slots_1", "level": 1 },
      { "pool": "slots_2", "level": 2 },
      { "pool": "slots_3", "level": 3 },
      { "pool": "slots_4", "level": 4 },
      { "pool": "slots_5", "level": 5 },
      { "pool": "slots_6", "level": 6 },
      { "pool": "slots_7", "level": 7 },
      { "pool": "slots_8", "level": 8 },
      { "pool": "slots_9", "level": 9 }
    ],
    "skills": [
      {
        "$comment": "Prepared spells, plus cantrips, which are cast without being prepared and are level 0 on this sheet.",
        "list": "spells",
        "onlyWhen": "prepared",
        "alwaysWhen": { "column": "level", "equals": 0 }
      },
      { "list": "attacks" }
    ]
  },
  "combat": {
    "$comment": "How a fight is RESOLVED by these rules, rather than what a fight may borrow from the sheet. Everything here is named by this file: the Engine never looks for 'hp', 'ac' or 'unconscious'. The battle block above is kept for an Engine that cannot read this one; a fight never uses both.",
    "kind": "attack-vs-defense",
    "health": { "pool": "hp" },
    "defense": { "field": "ac" },
    "initiative": { "dice": { "count": 1, "sides": 20 }, "modifier": { "derived": "initiative" } },

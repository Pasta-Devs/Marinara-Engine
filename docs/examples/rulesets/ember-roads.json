{
  "$comment": "A small example ruleset for the authoring guide. It rolls 2d6 plus a stat, to show that nothing in the format assumes a d20 or six abilities. Copy it, change the id, and make it yours.",
  "schemaVersion": 1,
  "id": "ember-roads",
  "version": 1,
  "name": "Ember Roads",
  "edition": "Example ruleset, first draft",
  "license": {
    "spdx": "CC0-1.0",
    "attribution": "Written for the Marinara Engine docs. Do what you like with it."
  },
  "coverage": {
    "checks": true,
    "saves": false,
    "sheet": true,
    "resources": true,
    "rests": true,
    "combat": true,
    "summary": "2d6 plus a stat against a difficulty, a short sheet with Grit and Luck, one rest, and fights resolved by these rules."
  },
  "resolution": {
    "kind": "dice-sum",
    "dice": {
      "count": 2,
      "sides": 6
    },
    "abilityModifier": {
      "op": "identity"
    },
    "proficiencyTiers": [
      {
        "id": "untrained",
        "label": "Untrained"
      },
      {
        "id": "trained",
        "label": "Trained",
        "flat": 1
      },
      {
        "id": "expert",
        "label": "Expert",
        "flat": 2
      }
    ],
    "advantage": false,
    "adjust": [
      { "value": { "derived": "burdened" }, "abilities": ["brawn"] },
      { "value": { "derived": "stance_brawn" }, "abilities": ["brawn"] }
    ],
    "difficultyLadder": [
      {
        "label": "Easy",
        "dc": 6
      },
      {
        "label": "Risky",
        "dc": 8
      },
      {
        "label": "Hard",
        "dc": 10
      },
      {
        "label": "Desperate",
        "dc": 12
      }
    ]
  },
  "sheet": {
    "version": 1,
    "sections": [
      {
        "id": "about",
        "label": "About"
      },
      {
        "id": "gear",
        "label": "Gear"
      },
      {
        "id": "knacks",
        "label": "Knacks"
      }
    ],
    "abilities": [
      {
        "id": "brawn",
        "label": "Brawn",
        "short": "BRN",
        "min": -1,
        "max": 3,
        "default": 0
      },
      {
        "id": "wits",
        "label": "Wits",
        "short": "WIT",
        "min": -1,
        "max": 3,
        "default": 0
      },
      {
        "id": "heart",
        "label": "Heart",
        "short": "HRT",
        "min": -1,
        "max": 3,
        "default": 0
      }
    ],
    "skills": [
      {
        "id": "scrap",
        "label": "Scrap",
        "ability": "brawn"
      },
      {
        "id": "sneak",
        "label": "Sneak",
        "ability": "wits"
      },
      {
        "$comment": "Fiddling with a mechanism nobody showed you costs two: an untrained Tinker check has two taken off its number.",
        "id": "tinker",
        "label": "Tinker",
        "ability": "wits",
        "untrained": { "by": -2 }
      },
      {
        "id": "sway",
        "label": "Sway",
        "ability": "heart"
      }
    ],
    "fields": [
      {
        "id": "calling",
        "label": "Calling",
        "type": "text",
        "maxLength": 60,
        "section": "about"
      },
      {
        "id": "toughness",
        "label": "Toughness",
        "type": "number",
        "min": 0,
        "max": 6,
        "default": 2,
        "section": "about"
      }
    ],
    "derived": [
      {
        "id": "grit_max",
        "label": "Grit maximum",
        "op": "sum",
        "of": [
          {
            "const": 4
          },
          {
            "field": "toughness"
          },
          {
            "abilityMod": "brawn"
          }
        ],
        "section": "about"
      },
      {
        "$comment": "What a blow has to beat. Two six-sided dice average seven, so a Guard of six or seven is an even fight.",
        "id": "guard",
        "label": "Guard",
        "op": "sum",
        "of": [
          {
            "const": 6
          },
          {
            "abilityMod": "wits"
          }
        ],
        "section": "about"
      },
      {
        "$comment": "How much a character is hauling: the bulk of every piece of gear they have packed, added up off the list rather than typed in beside it, so it can never drift from what they carry.",
        "id": "burden",
        "label": "Burden",
        "op": "sum",
        "of": [{ "listSum": { "list": "gear", "column": "bulk", "onlyWhen": "packed" } }],
        "section": "gear"
      },
      {
        "$comment": "Every three bulk slows a climb or a shove, so resolution.adjust takes this off every Brawn roll.",
        "id": "burdened",
        "label": "Burden on Brawn rolls",
        "op": "stepTable",
        "from": { "derived": "burden" },
        "table": [
          [0, 0],
          [3, -1],
          [6, -2],
          [9, -3]
        ],
        "section": "gear"
      },
      {
        "id": "strain_boxes",
        "label": "Strain boxes",
        "op": "sum",
        "of": [{ "const": 2 }, { "abilityMod": "heart" }],
        "section": "about"
      },
      {
        "$comment": "An enum table keyed on the live Stance, so it follows the stance as it changes in play. The resolution's adjust adds it to every roll made with Brawn: two for throwing caution away, one less for holding back.",
        "id": "stance_brawn",
        "label": "Stance on Brawn",
        "op": "enumTable",
        "from": { "liveState": "stance" },
        "table": { "guarded": -1, "reckless": 2 },
        "section": "about"
      }
    ],
    "lists": [
      {
        "id": "gear",
        "label": "Gear",
        "section": "gear",
        "maxItems": 20,
        "columns": [
          {
            "id": "name",
            "label": "Name",
            "type": "text",
            "maxLength": 60,
            "required": true
          },
          {
            "id": "notes",
            "label": "Notes",
            "type": "text",
            "maxLength": 200
          },
          {
            "$comment": "A piece of gear with damage dice is something you can swing. The rest of the list is rope and lamp oil, and a fight simply never offers it.",
            "id": "swing",
            "label": "Rolls with",
            "type": "enum",
            "values": ["brawn", "wits", "heart"],
            "default": "brawn"
          },
          {
            "id": "damage",
            "label": "Damage dice",
            "type": "dice",
            "example": "1d6"
          },
          {
            "id": "harm",
            "label": "Kind of harm",
            "type": "text",
            "maxLength": 20
          },
          {
            "id": "bulk",
            "label": "Bulk",
            "type": "number",
            "min": 0,
            "max": 3,
            "default": 0
          },
          {
            "id": "packed",
            "label": "Packed",
            "type": "boolean",
            "default": true
          }
        ]
      },
      {
        "id": "knacks",
        "label": "Knacks",
        "section": "knacks",
        "maxItems": 20,
        "columns": [
          {
            "id": "name",
            "label": "Name",
            "type": "text",
            "maxLength": 60,
            "required": true
          },
          {
            "id": "notes",
            "label": "What it does",
            "type": "text",
            "maxLength": 200
          }
        ]
      },
      {
        "$comment": "A list with pools: every row is a resource with its own maximum, and the camp rest gives back the ones that recharge there.",
        "id": "tricks",
        "label": "Limited tricks",
        "section": "knacks",
        "maxItems": 12,
        "columns": [
          {
            "id": "name",
            "label": "Name",
            "type": "text",
            "maxLength": 60,
            "required": true
          },
          {
            "id": "uses",
            "label": "Uses",
            "type": "number",
            "min": 0,
            "max": 9,
            "default": 1
          },
          {
            "id": "recharge",
            "label": "Comes back",
            "type": "enum",
            "values": ["camp", "scene"],
            "valueLabels": {
              "camp": "At camp",
              "scene": "Each scene"
            },
            "default": "camp"
          }
        ],
        "pools": {
          "nameColumn": "name",
          "maxColumn": "uses",
          "rechargeColumn": "recharge"
        }
      }
    ],
    "live": {
      "pools": [
        {
          "id": "grit",
          "label": "Grit",
          "max": {
            "derived": "grit_max"
          }
        },
        {
          "id": "luck",
          "label": "Luck",
          "max": {
            "const": 3
          }
        }
      ],
      "tracks": [
        {
          "id": "heat",
          "label": "Heat",
          "min": 0,
          "max": 5,
          "default": 0,
          "alwaysShow": true
        },
        {
          "$comment": "Numbered boxes rather than named levels, as many as Strain boxes works out. A hit marks the box its strength names, or the next free one above; with none free the hit does not land on the track, and in a fight that takes the traveller out. The table reads the boxes still clear: none left is -1 on every roll.",
          "id": "strain",
          "label": "Strain",
          "min": 0,
          "max": { "derived": "strain_boxes" },
          "boxes": {
            "penalty": {
              "by": "remaining",
              "table": [
                [0, -1],
                [1, 0]
              ]
            }
          },
          "kinds": [{ "id": "strain", "label": "S", "severity": 0 }],
          "fill": "indexed",
          "onFull": "refuse"
        }
      ],
      "conditions": [
        {
          "id": "shaken",
          "label": "Shaken"
        },
        {
          "id": "wounded",
          "label": "Wounded"
        },
        {
          "id": "pinned",
          "label": "Pinned"
        }
      ],
      "states": [
        {
          "$comment": "A LIVE STATE: exactly one of its values at a time, changing in play. The Game Master sets it with op=\"state\", the sheet shows a picker, and making camp settles it again.",
          "id": "stance",
          "label": "Stance",
          "values": ["guarded", "steady", "reckless"],
          "valueLabels": { "guarded": "Guarded", "steady": "Steady", "reckless": "Reckless" },
          "default": "steady"
        }
      ]
    }
  },
  "rests": [
    {
      "id": "camp",
      "label": "Make camp",
      "restore": [
        {
          "pool": "grit",
          "to": "max"
        },
        {
          "pool": "luck",
          "by": {
            "const": 1
          }
        },
        {
          "track": "heat",
          "by": {
            "const": -1
          }
        },
        {
          "listPools": "tricks",
          "recharge": ["camp"],
          "to": "max"
        },
        { "state": "stance", "to": "default" }
      ],
      "clear": {
        "conditions": ["shaken"]
      }
    }
  ],
  "gm": {
    "checkGuidance": "This game uses the Ember Roads rules. When the outcome of a risky action is in doubt, call for a check with one of the skills on the sheet and pick a difficulty from the ladder. The Engine rolls 2d6 and adds the numbers from the sheet. Never write the result yourself.",
    "sheetGuidance": "The character sheets below are authoritative. Spend Grit when a character is hurt and Luck when they push a roll, and raise Heat when the party draws attention.",
    "sheetSummary": {
      "fields": ["calling"],
      "derived": ["grit_max"],
      "lists": [
        {
          "list": "gear",
          "nameColumn": "name",
          "columns": ["damage"]
        }
      ]
    }
  },
  "catalogs": [
    {
      "$comment": "Ready-made knacks the sheet editor offers in a picker. Picked rows are copies the player can edit, and none of this text is ever sent to the model.",
      "id": "knacks",
      "label": "Knacks",
      "feeds": ["knacks", "tricks"],
      "filters": [
        {
          "id": "grit",
          "label": "Grit cost",
          "type": "number"
        },
        {
          "id": "road",
          "label": "Road",
          "type": "text"
        },
        {
          "id": "callings",
          "label": "Calling",
          "type": "tags",
          "startFrom": {
            "field": "calling"
          }
        }
      ],
      "units": {
        "distance": {
          "label": "paces",
          "perCell": 2
        }
      },
      "entries": [
        {
          "id": "road-sense",
          "label": "Road Sense",
          "summary": "You read a road the way other people read a face.",
          "filters": {
            "grit": 0,
            "road": "Ash Flats",
            "callings": ["Scout", "Courier"]
          },
          "rows": [
            {
              "list": "knacks",
              "values": {
                "name": "Road Sense",
                "notes": "Sneak to notice where a road turns bad before you are standing on it."
              }
            }
          ]
        },
        {
          "id": "scrap-whisper",
          "label": "Scrap Whisper",
          "summary": "Dead machines tell you what killed them.",
          "filters": {
            "grit": 0,
            "road": "Rustways",
            "callings": ["Tinker"]
          },
          "rows": [
            {
              "list": "knacks",
              "values": {
                "name": "Scrap Whisper",
                "notes": "Tinker to learn what a broken thing was last used for."
              }
            }
          ]
        },
        {
          "id": "iron-stomach",
          "label": "Iron Stomach",
          "summary": "You can eat what the road offers and keep walking.",
          "filters": {
            "grit": 0,
            "road": "Every road",
            "callings": ["Hauler"]
          },
          "rows": [
            {
              "list": "knacks",
              "values": {
                "name": "Iron Stomach",
                "notes": "Ignore the first Shaken you take from bad food or foul water."
              }
            }
          ]
        },
        {
          "$comment": "One entry, two rows: the knack itself and the limited use that tracks it.",
          "id": "last-ember",
          "label": "Last Ember",
          "summary": "Between camps you can call a friend back from the edge, once for each point of Heart.",
          "filters": {
            "grit": 1,
            "road": "Every road",
            "callings": ["Ember-tender"]
          },
          "rows": [
            {
              "list": "knacks",
              "values": {
                "name": "Last Ember",
                "notes": "Spend 1 Grit to give a downed friend 3 Grit back. Once between camps for each point of Heart."
              }
            },
            {
              "$comment": "The uses follow the character's Heart, so the row stays right as the character grows without anyone editing it. The value is fitted to the column, so a Heart of 3 gives 3 uses and a Heart of 0 or less leaves the trick with none.",
              "list": "tricks",
              "values": {
                "name": "Last Ember",
                "uses": 1,
                "recharge": "camp"
              },
              "scaled": {
                "uses": {
                  "from": {
                    "abilityScore": "heart"
                  }
                }
              }
            }
          ],
          "mechanics": {
            "kind": "heal",
            "range": 0,
            "targets": "ally",
            "amount": {
              "flat": 3
            },
            "cost": [
              {
                "pool": "grit",
                "amount": 1
              }
            ]
          }
        },
        {
          "id": "coldfire-toss",
          "label": "Coldfire Toss",
          "summary": "A jar of blue fire that burns cold and spreads.",
          "filters": {
            "grit": 1,
            "road": "Glasslands",
            "callings": ["Ember-tender"]
          },
          "rows": [
            {
              "list": "knacks",
              "values": {
                "name": "Coldfire Toss",
                "notes": "Throw a sealed jar. It burns up to three of those you pick, and a friend can be one of them."
              }
            }
          ],
          "mechanics": {
            "kind": "attack",
            "range": 12,
            "area": {
              "shape": "burst",
              "size": 4
            },
            "targets": "any",
            "targetCount": 3,
            "friendlyFire": true,
            "amount": {
              "dice": "2d6"
            },
            "damageType": "coldfire",
            "applies": [
              {
                "condition": "shaken",
                "duration": {
                  "rounds": 2
                }
              }
            ]
          }
        },
        {
          "id": "hold-the-line",
          "label": "Hold the Line",
          "summary": "You make the people beside you braver than they are.",
          "filters": {
            "grit": 0,
            "road": "Every road",
            "callings": ["Hauler", "Scout"]
          },
          "rows": [
            {
              "list": "knacks",
              "values": {
                "name": "Hold the Line",
                "notes": "Spend 1 Luck to steady one ally who can hear you. In a fight they gain 2 temporary Grit."
              }
            }
          ],
          "mechanics": {
            "$comment": "This one costs Luck, which the battle block names as the energy pool, so a battle offers it and spends it. Last Ember costs Grit, which is the health pool, and a battle cannot spend hit points as energy: that knack is left out of the fight instead.",
            "kind": "buff",
            "range": 4,
            "targets": "ally",
            "temporary": {
              "flat": 2
            },
            "cost": [
              {
                "pool": "luck",
                "amount": 1
              }
            ]
          }
        },
        {
          "$comment": "One entry, two rows: the knack and the trick that counts it. Using it hands back the one thing this system's turn has, and the count is the trick row's own pool, so nothing here names a cost.",
          "id": "second-breath",
          "label": "Second Breath",
          "summary": "Once a scene, find one more thing to do before the moment passes.",
          "filters": {
            "grit": 0,
            "road": "Every road",
            "callings": ["Hauler", "Scout"]
          },
          "rows": [
            {
              "list": "knacks",
              "values": {
                "name": "Second Breath",
                "notes": "Once a scene, take a second Action on your turn."
              }
            },
            {
              "list": "tricks",
              "values": {
                "name": "Second Breath",
                "uses": 1,
                "recharge": "scene"
              }
            }
          ],
          "mechanics": {
            "kind": "utility",
            "free": true,
            "gives": [
              {
                "budget": "act",
                "count": 1
              }
            ]
          }
        }
      ]
    },
    {
      "$comment": "A bestiary. It holds creatures instead of rows, so it feeds no list and the sheet editor's picker never offers it: a fight reads this, not a character sheet. Every number is written in the keys the combat block above declares.",
      "id": "road_trouble",
      "label": "Road trouble",
      "holds": "creatures",
      "filters": [
        {
          "id": "tier",
          "label": "How bad",
          "type": "text"
        },
        {
          "id": "road",
          "label": "Road",
          "type": "text"
        }
      ],
      "entries": [
        {
          "id": "cinder-moth",
          "label": "Cinder Moth",
